# Stock Radar 配置
# 复制这个文件为 .env 并填入你的配置（用于本地测试）
# 生产环境请在 GitHub Actions Secrets 中设置同名变量

# ── 通知推送 ──
# 总开关
NOTIFY_ENABLED=1

# 关注股代码（逗号分隔，用于通知时匹配）
WATCHLIST_CODES=600519,300750,NVDA

# 渠道一：企业微信机器人（群聊加机器人获取 webhook URL）
WECHAT_WEBHOOK_URL=

# 渠道二：Telegram Bot（找 @BotFather 创建机器人获取 token）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 渠道三：Bark (iOS)（安装 Bark App 后获取推送 URL）
BARK_URL=

# 通知最低重要性分数（默认 70 = high）
NOTIFY_MIN_SCORE=70
